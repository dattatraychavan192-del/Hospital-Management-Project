PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:4200

# Optional values for `npm run create-admin --workspace=server`.
# Keep the administrator password private and at least 12 characters long.
# ADMIN_NAME=Hospital Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-private-password-of-at-least-12-characters
